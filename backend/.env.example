# Copy to backend/.env and fill in. NEVER commit .env. Generate a secret key with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me-generate-a-long-random-value
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Admin URL path (use a non-default value outside local development)
DJANGO_ADMIN_URL=admin/
DJANGO_LOG_LEVEL=INFO

# Local PostgreSQL (the role needs CREATEDB to run the test suite)
DB_NAME=talim_dev
DB_USER=talim_dev
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=5432

# Key(s) that encrypt TOTP secrets at rest. Comma-separated, NEWEST FIRST (older keys keep decrypting = rotation).
# Generate:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing this key means every administrator must re-enrol 2FA. Back it up separately from database backups.
OTP_ENCRYPTION_KEYS=

# E-mail. Leave EMAIL_BACKEND unset in development: messages are written to backend/.dev_mail/ (gitignored),
# never sent. Production requires explicit SMTP settings (see docs/PRODUCTION_SECURITY_REQUIREMENTS.md).
# DEFAULT_FROM_EMAIL=no-reply@localhost
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=1

# Content-Security-Policy: 1 = report-only (default), 0 = enforce (after the report-only observation period).
# DJANGO_CSP_REPORT_ONLY=1

# Reverse proxy (B-1). Comma-separated addresses/networks of YOUR proxy only. Empty = forwarded headers are ignored.
# Never put user networks here. Not verified against a real Nginx yet: see docs/PRODUCTION_SECURITY_REQUIREMENTS.md.
# DJANGO_TRUSTED_PROXIES=127.0.0.1,::1

# Documents: private storage (outside static/media; must be backed up) and upload limit in bytes.
# DJANGO_PRIVATE_MEDIA_ROOT=/var/lib/talim/private_media
# DOCUMENT_MAX_BYTES=10485760
# E-mail copies of in-app notifications (OFF by default; enable only after SMTP is configured and verified).
# NOTIFICATION_EMAILS_ENABLED=0

# Antivirus (ClamAV). Uploads are REFUSED if the scan cannot finish. "disabled" is for development only; production refuses it.
# DOCUMENT_SCAN_MODE=clamav
# CLAMAV_SOCKET=/run/clamav/clamd.ctl
# CLAMAV_HOST=127.0.0.1
# CLAMAV_PORT=3310
# CLAMAV_TIMEOUT=20
