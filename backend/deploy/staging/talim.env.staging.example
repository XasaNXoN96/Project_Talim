# STAGING environment file TEMPLATE. Copy to /etc/talim/talim.env (root:talim, mode 0640) on the server and fill in the values THERE.
# Never commit the filled file. Every value below is a placeholder; preflight.py refuses placeholders. Names only, no real values.
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=CHANGE_ME_generate_with_secrets.token_urlsafe(70)
DJANGO_ALLOWED_HOSTS=CHANGE_ME_staging_host_name
DJANGO_CSRF_TRUSTED_ORIGINS=https://CHANGE_ME_staging_host_name
DJANGO_ADMIN_URL=CHANGE_ME_long_random_path/
DJANGO_TRUSTED_PROXIES=127.0.0.1
DJANGO_PRIVATE_MEDIA_ROOT=/var/lib/talim/private_media
# HSTS stays 0 until real HTTPS has been verified from a browser (docs/DEPLOYMENT_READINESS.md §4.12)
DJANGO_HSTS_SECONDS=0
# the RUNTIME role (no ownership, no DDL). Migrations run with the owner role, supplied only at release time (MIGRATE_CMD_PREFIX).
DB_NAME=talim_staging
DB_USER=talim_app
DB_PASSWORD=CHANGE_ME_database_password
DB_HOST=127.0.0.1
DB_PORT=5432
# newest key first; generated with cryptography.fernet.Fernet.generate_key()
OTP_ENCRYPTION_KEYS=CHANGE_ME_fernet_key
# fail-closed: a document is available only after ClamAV said "clean"
DOCUMENT_SCAN_MODE=clamav
EMAIL_HOST=CHANGE_ME_smtp_host
DEFAULT_FROM_EMAIL=CHANGE_ME_sender_address
