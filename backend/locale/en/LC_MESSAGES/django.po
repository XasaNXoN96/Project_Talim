#, python-format
msgid ""
"Assalomu alaykum, %(name)s!\n"
"\n"
"Siz uchun %(site)s xodimlar portalida hisob yaratildi.\n"
"Login: %(login)s\n"
"\n"
"Parolni o‘rnatish uchun havolaga o‘ting (30 daqiqa amal qiladi, faqat bir marta ishlaydi):\n"
"\n"
"%(link)s\n"
"\n"
"Havola muddati tugasa, kirish sahifasidagi «Parolni unutdingizmi?» orqali yangisini so‘rang.\n"
msgstr ""
"Hello, %(name)s!\n"
"\n"
"An account was created for you on the “%(site)s” staff portal.\n"
"Username: %(login)s\n"
"\n"
"To set your password, open this link (valid for 30 minutes, works only once):\n"
"\n"
"%(link)s\n"
"\n"
"If the link has expired, request a new one with “Forgot your password?” on the sign-in page.\n"

