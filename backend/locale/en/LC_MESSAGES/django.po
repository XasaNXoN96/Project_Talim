msgid "Rollar va huquqlar"
msgstr "Roles and permissions"

msgid "Faqat o‘zi"
msgstr "Own only"

msgid "Bo‘lim"
msgstr "Department"

msgid "Butun tashkilot"
msgstr "Whole organization"

msgid "rol biriktirish"
msgstr "role assignment"

msgid "rol biriktirishlar"
msgstr "role assignments"

msgid "Bo‘lim doirasi uchun bo‘lim ko‘rsatilishi shart."
msgstr "A department is required for the “Department” scope."

msgid "Bo‘lim faqat «Bo‘lim» doirasi uchun ko‘rsatiladi."
msgstr "A department can only be set for the “Department” scope."

msgid "Xodim"
msgstr "Employee"

msgid "Bo‘lim boshlig‘i"
msgstr "Department head"

msgid "Kontent-menejer"
msgstr "Content manager"

msgid "Kadrlar bo‘limi"
msgstr "HR department"

msgid "Administrator"
msgstr "Administrator"

msgid "Yangilik muallifi"
msgstr "News author"

msgid "Yangilik muharriri"
msgstr "News editor"

msgid "Yangilik nashr etuvchisi"
msgstr "News publisher"

msgid "Tizim administratori"
msgstr "System administrator"

msgid "Yangilik yozadi va o‘z qoralamalarini tahrirlaydi, tekshiruvga yuboradi, o‘z yangiliklari bo‘yicha qarorlar va izohlarni ko‘radi. Ma’qullay yoki nashr eta olmaydi."
msgstr "Writes news and edits their own drafts, submits them for review, sees the decisions and comments on their own items. Cannot approve or publish."

msgid "Tekshiruvdagi yangiliklarni ko‘radi, ma’qullaydi yoki majburiy izoh bilan qaytaradi. Yozmaydi va nashr etmaydi; o‘z yangiligini ma’qullay olmaydi."
msgstr "Sees items under review and approves them or returns them with a mandatory comment. Does not write or publish; cannot approve their own item."

msgid "Faqat ma’qullangan yangilikni nashr etadi va nashrdan oladi. Qoralamani to‘g‘ridan-to‘g‘ri nashr eta olmaydi."
msgstr "Publishes only approved news and takes it down. Cannot publish a draft directly."

msgid "Yangilikni yozadi, tekshiradi va nashr etadi (o‘zinikini ma’qullay olmaydi)."
msgstr "Writes, reviews and publishes news (cannot approve their own)."

