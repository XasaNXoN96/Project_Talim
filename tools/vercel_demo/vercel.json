{
  "functions": {
    "api/index.py": {
      "includeFiles": "{backend,assets}/**",
      "maxDuration": 30
    },
    "api/setup.py": {
      "includeFiles": "{backend,assets}/**",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}